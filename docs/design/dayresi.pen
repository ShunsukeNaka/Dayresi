{
  "version": "2.21",
  "variables": {
    "color.bg": {
      "type": "color",
      "value": "#F5F3EE"
    },
    "color.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.surface-2": {
      "type": "color",
      "value": "#F8F6F1"
    },
    "color.border": {
      "type": "color",
      "value": "#E4DFD4"
    },
    "color.text": {
      "type": "color",
      "value": "#1D1B17"
    },
    "color.muted": {
      "type": "color",
      "value": "#6E685D"
    },
    "color.primary": {
      "type": "color",
      "value": "#24407A"
    },
    "color.primary-soft": {
      "type": "color",
      "value": "#E8EDF7"
    },
    "color.on-primary": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.brand": {
      "type": "color",
      "value": "#C9461C"
    },
    "color.brand-soft": {
      "type": "color",
      "value": "#FBEAE2"
    },
    "color.accent": {
      "type": "color",
      "value": "#0E7A5A"
    },
    "color.accent-soft": {
      "type": "color",
      "value": "#E2F2EB"
    },
    "color.danger": {
      "type": "color",
      "value": "#B42318"
    },
    "color.danger-soft": {
      "type": "color",
      "value": "#FDECEA"
    },
    "color.scrim": {
      "type": "color",
      "value": "#1D1B178C"
    },
    "radius.sm": {
      "type": "number",
      "value": 10
    },
    "radius.md": {
      "type": "number",
      "value": 14
    },
    "radius.lg": {
      "type": "number",
      "value": 20
    }
  },
  "children": [
    {
      "id": "components",
      "type": "frame",
      "layout": "vertical",
      "x": 0,
      "y": 0,
      "padding": 48,
      "gap": 40,
      "fill": "#ECE8E0",
      "cornerRadius": 24,
      "name": "コンポーネント",
      "children": [
        {
          "id": "components-head",
          "type": "frame",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "id": "components-title",
              "type": "text",
              "content": "コンポーネント",
              "fontFamily": "Noto Sans JP",
              "fontSize": 28,
              "fontWeight": "800",
              "fill": "$color.text"
            },
            {
              "id": "components-desc",
              "type": "text",
              "content": "Dayresi デザイン案。画面はすべてここのコンポーネントの組み合わせで作る。",
              "fontFamily": "Noto Sans JP",
              "fontSize": 15,
              "fontWeight": "400",
              "fill": "$color.muted"
            }
          ]
        },
        {
          "id": "sec-buttons",
          "type": "frame",
          "layout": "vertical",
          "gap": 14,
          "children": [
            {
              "id": "sec-buttons-head",
              "type": "frame",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "id": "sec-buttons-title",
                  "type": "text",
                  "content": "ボタン",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 15,
                  "fontWeight": "700",
                  "fill": "$color.text"
                },
                {
                  "id": "sec-buttons-desc",
                  "type": "text",
                  "content": "主操作は紺、取り消せない操作は赤系の控えめな色にする",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 13,
                  "fontWeight": "400",
                  "fill": "$color.muted"
                }
              ]
            },
            {
              "id": "sec-buttons-row",
              "type": "frame",
              "layout": "horizontal",
              "gap": 20,
              "alignItems": "start",
              "children": [
                {
                  "id": "c-btn-primary",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-btn-primary",
                  "padding": [
                    14,
                    22
                  ],
                  "gap": 8,
                  "cornerRadius": "$radius.sm",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "fill": "$color.primary",
                  "children": [
                    {
                      "id": "c-btn-primary-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "plus",
                      "width": 20,
                      "height": 20,
                      "fill": "$color.on-primary"
                    },
                    {
                      "id": "c-btn-primary-label",
                      "type": "text",
                      "content": "ボタン",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 16,
                      "fontWeight": "700",
                      "fill": "$color.on-primary"
                    }
                  ]
                },
                {
                  "id": "c-btn-secondary",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-btn-secondary",
                  "padding": [
                    14,
                    22
                  ],
                  "gap": 8,
                  "cornerRadius": "$radius.sm",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "fill": "$color.surface",
                  "children": [
                    {
                      "id": "c-btn-secondary-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "plus",
                      "width": 20,
                      "height": 20,
                      "fill": "$color.text"
                    },
                    {
                      "id": "c-btn-secondary-label",
                      "type": "text",
                      "content": "ボタン",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 16,
                      "fontWeight": "700",
                      "fill": "$color.text"
                    }
                  ],
                  "stroke": "$color.border",
                  "strokeWidth": 1.5,
                  "strokeAlignment": "inner",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 3,
                    "color": "#1D1B1714"
                  }
                },
                {
                  "id": "c-btn-danger",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-btn-danger",
                  "padding": [
                    14,
                    22
                  ],
                  "gap": 8,
                  "cornerRadius": "$radius.sm",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "fill": "$color.danger-soft",
                  "children": [
                    {
                      "id": "c-btn-danger-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "plus",
                      "width": 20,
                      "height": 20,
                      "fill": "$color.danger"
                    },
                    {
                      "id": "c-btn-danger-label",
                      "type": "text",
                      "content": "ボタン",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 16,
                      "fontWeight": "700",
                      "fill": "$color.danger"
                    }
                  ],
                  "stroke": "$color.danger",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner"
                },
                {
                  "id": "c-icon-btn",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-icon-btn",
                  "width": 40,
                  "height": 40,
                  "cornerRadius": "$radius.sm",
                  "fill": "$color.surface",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "stroke": "$color.border",
                  "strokeWidth": 1.5,
                  "strokeAlignment": "inner",
                  "children": [
                    {
                      "id": "c-icon-btn-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "arrow-up",
                      "width": 18,
                      "height": 18,
                      "fill": "$color.text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sec-nav",
          "type": "frame",
          "layout": "vertical",
          "gap": 14,
          "children": [
            {
              "id": "sec-nav-head",
              "type": "frame",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "id": "sec-nav-title",
                  "type": "text",
                  "content": "ナビゲーション",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 15,
                  "fontWeight": "700",
                  "fill": "$color.text"
                }
              ]
            },
            {
              "id": "sec-nav-row",
              "type": "frame",
              "layout": "horizontal",
              "gap": 20,
              "alignItems": "start",
              "children": [
                {
                  "id": "c-tab",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-tab",
                  "padding": [
                    10,
                    20
                  ],
                  "gap": 8,
                  "cornerRadius": "$radius.sm",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "c-tab-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "shopping-basket",
                      "width": 18,
                      "height": 18,
                      "fill": "$color.muted"
                    },
                    {
                      "id": "c-tab-label",
                      "type": "text",
                      "content": "レジ",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 15,
                      "fontWeight": "500",
                      "fill": "$color.muted"
                    }
                  ]
                },
                {
                  "id": "c-tab-active",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-tab-active",
                  "padding": [
                    10,
                    20
                  ],
                  "gap": 8,
                  "cornerRadius": "$radius.sm",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "c-tab-active-icon",
                      "type": "icon",
                      "library": "lucide",
                      "icon": "shopping-basket",
                      "width": 18,
                      "height": 18,
                      "fill": "$color.primary"
                    },
                    {
                      "id": "c-tab-active-label",
                      "type": "text",
                      "content": "レジ",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 15,
                      "fontWeight": "700",
                      "fill": "$color.primary"
                    }
                  ],
                  "fill": "$color.surface",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 3,
                    "color": "#1D1B1714"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sec-topbar",
          "type": "frame",
          "layout": "vertical",
          "gap": 14,
          "children": [
            {
              "id": "sec-topbar-head",
              "type": "frame",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "id": "sec-topbar-title",
                  "type": "text",
                  "content": "上部バー",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 15,
                  "fontWeight": "700",
                  "fill": "$color.text"
                },
                {
                  "id": "sec-topbar-desc",
                  "type": "text",
                  "content": "ロゴ・タブ・保存先の表示。タブはどの画面でも同じ位置",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 13,
                  "fontWeight": "400",
                  "fill": "$color.muted"
                }
              ]
            },
            {
              "id": "sec-topbar-row",
              "type": "frame",
              "layout": "horizontal",
              "gap": 20,
              "alignItems": "start",
              "children": [
                {
                  "id": "c-topbar",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-topbar",
                  "width": 1440,
                  "height": 68,
                  "padding": [
                    0,
                    28
                  ],
                  "alignItems": "center",
                  "justifyContent": "space_between",
                  "fill": "$color.surface",
                  "stroke": "$color.border",
                  "strokeWidth": {
                    "bottom": 1
                  },
                  "children": [
                    {
                      "id": "c-topbar-brand",
                      "type": "frame",
                      "layout": "horizontal",
                      "gap": 10,
                      "alignItems": "center",
                      "width": 360,
                      "children": [
                        {
                          "id": "c-topbar-logo",
                          "type": "frame",
                          "layout": "horizontal",
                          "width": 36,
                          "height": 36,
                          "cornerRadius": "$radius.sm",
                          "fill": "$color.brand",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "id": "c-topbar-logo-icon",
                              "type": "icon",
                              "library": "lucide",
                              "icon": "receipt-japanese-yen",
                              "width": 20,
                              "height": 20,
                              "fill": "$color.on-primary"
                            }
                          ]
                        },
                        {
                          "id": "c-topbar-wordmark",
                          "type": "text",
                          "content": "Dayresi",
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "800",
                          "fill": "$color.text",
                          "letterSpacing": -0.4
                        },
                        {
                          "id": "c-topbar-tagline",
                          "type": "text",
                          "content": "その日だけのレジ",
                          "fontFamily": "Noto Sans JP",
                          "fontSize": 13,
                          "fontWeight": "500",
                          "fill": "$color.muted"
                        }
                      ]
                    },
                    {
                      "id": "c-topbar-tabs",
                      "type": "frame",
                      "layout": "horizontal",
                      "padding": 4,
                      "gap": 4,
                      "cornerRadius": "$radius.md",
                      "fill": "$color.surface-2",
                      "stroke": "$color.border",
                      "strokeWidth": 1.5,
                      "strokeAlignment": "inner",
                      "children": [
                        {
                          "id": "c-topbar-tab-register",
                          "type": "ref",
                          "ref": "c-tab-active",
                          "descendants": {
                            "c-tab-active-icon": {
                              "icon": "shopping-basket"
                            },
                            "c-tab-active-label": {
                              "content": "レジ"
                            }
                          }
                        },
                        {
                          "id": "c-topbar-tab-history",
                          "type": "ref",
                          "ref": "c-tab",
                          "descendants": {
                            "c-tab-icon": {
                              "icon": "history"
                            },
                            "c-tab-label": {
                              "content": "履歴"
                            }
                          }
                        },
                        {
                          "id": "c-topbar-tab-summary",
                          "type": "ref",
                          "ref": "c-tab",
                          "descendants": {
                            "c-tab-icon": {
                              "icon": "chart-column"
                            },
                            "c-tab-label": {
                              "content": "集計"
                            }
                          }
                        },
                        {
                          "id": "c-topbar-tab-settings",
                          "type": "ref",
                          "ref": "c-tab",
                          "descendants": {
                            "c-tab-icon": {
                              "icon": "settings"
                            },
                            "c-tab-label": {
                              "content": "設定"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "c-topbar-storage",
                      "type": "frame",
                      "layout": "horizontal",
                      "width": 360,
                      "justifyContent": "end",
                      "children": [
                        {
                          "id": "c-topbar-storage-chip",
                          "type": "frame",
                          "layout": "horizontal",
                          "gap": 6,
                          "padding": [
                            6,
                            12
                          ],
                          "cornerRadius": 999,
                          "fill": "$color.surface-2",
                          "alignItems": "center",
                          "children": [
                            {
                              "id": "c-topbar-storage-icon",
                              "type": "icon",
                              "library": "lucide",
                              "icon": "hard-drive",
                              "width": 14,
                              "height": 14,
                              "fill": "$color.muted"
                            },
                            {
                              "id": "c-topbar-storage-label",
                              "type": "text",
                              "content": "この端末のブラウザにだけ保存",
                              "fontFamily": "Noto Sans JP",
                              "fontSize": 13,
                              "fontWeight": "500",
                              "fill": "$color.muted"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sec-register",
          "type": "frame",
          "layout": "vertical",
          "gap": 14,
          "children": [
            {
              "id": "sec-register-head",
              "type": "frame",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "id": "sec-register-title",
                  "type": "text",
                  "content": "レジ",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 15,
                  "fontWeight": "700",
                  "fill": "$color.text"
                },
                {
                  "id": "sec-register-desc",
                  "type": "text",
                  "content": "商品ボタンはカートに入ると朱のバッジで数量を表示する",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 13,
                  "fontWeight": "400",
                  "fill": "$color.muted"
                }
              ]
            },
            {
              "id": "sec-register-row",
              "type": "frame",
              "layout": "horizontal",
              "gap": 20,
              "alignItems": "start",
              "children": [
                {
                  "id": "c-product",
                  "type": "frame",
                  "layout": "vertical",
                  "reusable": true,
                  "name": "c-product",
                  "width": 225,
                  "height": 132,
                  "padding": 16,
                  "gap": 6,
                  "cornerRadius": "$radius.md",
                  "fill": "$color.surface",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 3,
                    "color": "#1D1B1714"
                  },
                  "justifyContent": "center",
                  "alignItems": "center",
                  "stroke": "$color.border",
                  "strokeWidth": 1.5,
                  "strokeAlignment": "inner",
                  "children": [
                    {
                      "id": "c-product-name",
                      "type": "text",
                      "content": "焼きそば",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 20,
                      "fontWeight": "700",
                      "fill": "$color.text",
                      "textAlign": "center",
                      "width": "fill_container",
                      "textGrowth": "fixed-width"
                    },
                    {
                      "id": "c-product-price",
                      "type": "text",
                      "content": "¥400",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "600",
                      "fill": "$color.muted",
                      "textAlign": "center",
                      "width": "fill_container",
                      "textGrowth": "fixed-width"
                    },
                    {
                      "id": "c-product-badge",
                      "type": "frame",
                      "layout": "horizontal",
                      "layoutPosition": "absolute",
                      "x": 181,
                      "y": 12,
                      "width": 32,
                      "height": 32,
                      "cornerRadius": 16,
                      "fill": "$color.brand",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "enabled": false,
                      "children": [
                        {
                          "id": "c-product-badge-count",
                          "type": "text",
                          "content": "1",
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "800",
                          "fill": "$color.on-primary"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "c-cart-row",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-cart-row",
                  "width": 372,
                  "padding": [
                    14,
                    0
                  ],
                  "gap": 12,
                  "alignItems": "center",
                  "stroke": "$color.border",
                  "strokeWidth": {
                    "bottom": 1
                  },
                  "children": [
                    {
                      "id": "c-cart-row-name",
                      "type": "text",
                      "content": "焼きそば",
                      "fontFamily": "Noto Sans JP",
                      "fontSize": 17,
                      "fontWeight": "600",
                      "fill": "$color.text",
                      "width": "fill_container",
                      "textGrowth": "fixed-width"
                    },
                    {
                      "id": "c-cart-row-stepper",
                      "type": "frame",
                      "layout": "horizontal",
                      "padding": 3,
                      "cornerRadius": "$radius.sm",
                      "fill": "$color.surface-2",
                      "alignItems": "center",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "children": [
                        {
                          "id": "c-cart-row-minus",
                          "type": "frame",
                          "layout": "horizontal",
                          "width": 40,
                          "height": 40,
                          "cornerRadius": 8,
                          "fill": "$color.surface",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "effect": {
                            "type": "shadow",
                            "shadowType": "outer",
                            "offset": {
                              "x": 0,
                              "y": 1
                            },
                            "blur": 3,
                            "color": "#1D1B1714"
                          },
                          "children": [
                            {
                              "id": "c-cart-row-minus-icon",
                              "type": "icon",
                              "library": "lucide",
                              "icon": "minus",
                              "width": 18,
                              "height": 18,
                              "fill": "$color.text"
                            }
                          ]
                        },
                        {
                          "id": "c-cart-row-qty",
                          "type": "text",
                          "content": "1",
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "700",
                          "fill": "$color.text",
                          "textAlign": "center",
                          "width": 36,
                          "textGrowth": "fixed-width"
                        },
                        {
                          "id": "c-cart-row-plus",
                          "type": "frame",
                          "layout": "horizontal",
                          "width": 40,
                          "height": 40,
                          "cornerRadius": 8,
                          "fill": "$color.surface",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "effect": {
                            "type": "shadow",
                            "shadowType": "outer",
                            "offset": {
                              "x": 0,
                              "y": 1
                            },
                            "blur": 3,
                            "color": "#1D1B1714"
                          },
                          "children": [
                            {
                              "id": "c-cart-row-plus-icon",
                              "type": "icon",
                              "library": "lucide",
                              "icon": "plus",
                              "width": 18,
                              "height": 18,
                              "fill": "$color.text"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "c-cart-row-subtotal",
                      "type": "text",
                      "content": "¥400",
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "700",
                      "fill": "$color.text",
                      "textAlign": "right",
                      "width": 84,
                      "textGrowth": "fixed-width"
                    }
                  ]
                },
                {
                  "id": "c-key",
                  "type": "frame",
                  "layout": "horizontal",
                  "reusable": true,
                  "name": "c-key",
                  "width": 140,
                  "height": 60,
                  "cornerRadius": "$radius.sm",
                  "fill": "$color.surface",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "offset": {
                      "x": 0,
